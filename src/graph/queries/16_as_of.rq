# 한 객체의 시각 {{AT}} 값 (시점별 판). 기본은 증미역 역사 건물
# 트리플마다 그 시각 이전의 마지막 사건으로 정한다. 사건은 그래프가 실제로 바뀐 변경만 남으므로 넣기와 빼기가 번갈아 나온다
# 주어를 가지마다 직접 적는다. 바깥 VALUES로 주면 UNION 안으로 전달되지 않아 모든 트리플을 훑는다
PREFIX jgk: <https://yeodh10.github.io/jeungmi-geokg/def#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?p ?o WHERE {
  {
    # 사건이 없는 트리플: 지금 값 그대로
    <{{URI}}> ?p ?o .
    FILTER NOT EXISTS { ?e rdf:subject <{{URI}}> ; rdf:predicate ?p ; rdf:object ?o ; jgk:changeOrder ?any }
  } UNION {
    # 그 시각 이전의 마지막 사건이 넣기
    ?c rdf:subject <{{URI}}> ; jgk:changeOp "add" ; rdf:predicate ?p ; rdf:object ?o ; jgk:decidedAt ?t ; jgk:changeOrder ?n .
    FILTER (?t <= "{{AT}}"^^xsd:dateTime)
    FILTER NOT EXISTS { ?c2 rdf:subject <{{URI}}> ; rdf:predicate ?p ; rdf:object ?o ; jgk:decidedAt ?t2 ; jgk:changeOrder ?n2 .
                        FILTER (?t2 <= "{{AT}}"^^xsd:dateTime && ?n2 > ?n) }
  } UNION {
    # 그 시각 이전에 사건이 없고 첫 사건이 빼기: 원래 있던 값
    ?c rdf:subject <{{URI}}> ; jgk:changeOp "remove" ; rdf:predicate ?p ; rdf:object ?o ; jgk:changeOrder ?n .
    FILTER NOT EXISTS { ?c2 rdf:subject <{{URI}}> ; rdf:predicate ?p ; rdf:object ?o ; jgk:changeOrder ?n2 . FILTER (?n2 < ?n) }
    FILTER NOT EXISTS { ?c3 rdf:subject <{{URI}}> ; rdf:predicate ?p ; rdf:object ?o ; jgk:decidedAt ?t3 .
                        FILTER (?t3 <= "{{AT}}"^^xsd:dateTime) }
  }
}
