# 국가기본도, 수치지형도 건물과 이어진 우리 건물: 지도별, 상태별 개수와 겹침 정도(IoU) 평균
# 우리 건물 모양은 GIS건물통합정보다. 서로 가장 많이 겹치고 IoU 0.5 이상인 짝만 잇는다. 받은 영역이 지도마다 다르다
# 승인으로 넣은 연결에는 IoU가 없을 수 있다. 값이 없는 줄이 하나라도 있으면 합계가 오류가 되므로 빈 값을 0, 거짓으로 채워 센다
# 그래서 수치지형도의 pnuSame, addressSame은 0이다. 수치지형도 연결에는 PNU, 주소 확인 결과를 적지 않는다
PREFIX jgk: <https://yeodh10.github.io/jeungmi-geokg/def#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?map ?status (COUNT(?b) AS ?linked) (ROUND(SUM(COALESCE(?iou, 0)) / COUNT(?iou) * 1000) / 1000 AS ?meanIoU)
       (SUM(IF(COALESCE(?pnu, false), 1, 0)) AS ?pnuSame) (SUM(IF(COALESCE(?addr, false), 1, 0)) AS ?addressSame) WHERE {
  { ?b jgk:basemapFeature ?m . BIND("국가기본도" AS ?map) } UNION { ?b jgk:digitalMapFeature ?m . BIND("수치지형도" AS ?map) }
  ?b jgk:status/rdfs:label ?status .
  OPTIONAL { ?m jgk:matchIoU ?iou } OPTIONAL { ?m jgk:pnuAgrees ?pnu } OPTIONAL { ?m jgk:addressAgrees ?addr }
} GROUP BY ?map ?status ORDER BY ?map ?status
