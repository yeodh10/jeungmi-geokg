@prefix jgk: <https://yeodh10.github.io/jeungmi-geokg/def#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .

# 증미역 공간 지식 그래프 어휘
# 모든 객체는 geo:Feature, 모양은 geo:Geometry로 따로 둔다.

<https://yeodh10.github.io/jeungmi-geokg/def> a owl:Ontology ;
    rdfs:label "증미역 공간 지식 그래프 어휘"@ko ;
    owl:imports <http://www.opengis.net/ont/geosparql> .

# 객체 종류

jgk:Building a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "건물"@ko .
jgk:BuildingEntrance a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "건물 출입구"@ko .
jgk:RoadSegment a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "도로 구간"@ko .
jgk:Parcel a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "필지"@ko ;
    rdfs:comment "PNU로 식별한다. 모양은 연속지적도(참조용 도면)에서 PNU가 같은 폴리곤을 붙이고, 모양 노드의 출처를 연속지적도로 적는다."@ko .
jgk:PublicFacility a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "공공시설"@ko .
jgk:Station a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "역"@ko .
jgk:AdminDong a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "행정동"@ko .
jgk:Road a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "도로"@ko ;
    rdfs:comment "도로명 하나. 번호는 도로명코드(시군구코드 5자리 + 도로명번호 7자리)다. 모양은 도로 구간이 가진다."@ko .
jgk:LegalDong a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "법정동"@ko .
jgk:BasicZone a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "기초구역"@ko ;
    rdfs:comment "국가기초구역. 번호 5자리는 우편번호와 같다."@ko .
jgk:Business a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "상호"@ko ;
    rdfs:comment "소상공인시장진흥공단 상가(상권)정보의 업소 한 행. 번호는 상가업소번호(20자리)다. 같은 가게가 두 이름으로 두 행일 때도 원천 행을 그대로 둔다. 모양은 원천의 경도, 위도 점이다. 영업시간, 전화, 리뷰는 이 자료에 없다."@ko .

# 국가기본도(수치지도) 지형지물 분류
# 수치지도 작성 작업규칙(국토교통부령) 제9조 제2항의 대분류 8개. 세분류는 국토지리정보원장이 정한다(같은 조 제3항).
# 이 어휘의 객체 종류가 어느 대분류에 드는지 jgk:basemapClass로 적는다. 대분류가 분명하지 않은 종류(출입구, 필지, 역, 공공시설, 기초구역)는 적지 않는다.

jgk:basemap-classes a skos:ConceptScheme ;
    rdfs:label "수치지도 지형지물 분류체계 (수치지도 작성 작업규칙 제9조)"@ko ;
    dcterms:source <https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=171727> .
jgk:basemap-A a skos:Concept ; skos:inScheme jgk:basemap-classes ; skos:notation "A" ; skos:prefLabel "교통"@ko .
jgk:basemap-B a skos:Concept ; skos:inScheme jgk:basemap-classes ; skos:notation "B" ; skos:prefLabel "건물"@ko .
jgk:basemap-C a skos:Concept ; skos:inScheme jgk:basemap-classes ; skos:notation "C" ; skos:prefLabel "시설"@ko .
jgk:basemap-D a skos:Concept ; skos:inScheme jgk:basemap-classes ; skos:notation "D" ; skos:prefLabel "식생"@ko .
jgk:basemap-E a skos:Concept ; skos:inScheme jgk:basemap-classes ; skos:notation "E" ; skos:prefLabel "수계"@ko .
jgk:basemap-F a skos:Concept ; skos:inScheme jgk:basemap-classes ; skos:notation "F" ; skos:prefLabel "지형"@ko .
jgk:basemap-G a skos:Concept ; skos:inScheme jgk:basemap-classes ; skos:notation "G" ; skos:prefLabel "경계"@ko .
jgk:basemap-H a skos:Concept ; skos:inScheme jgk:basemap-classes ; skos:notation "H" ; skos:prefLabel "주기"@ko .

jgk:basemapClass a owl:AnnotationProperty ; rdfs:label "국가기본도 지형지물 대분류"@ko ;
    rdfs:comment "객체 종류(owl:Class)가 수치지도 지형지물 분류체계의 어느 대분류에 드는지 적는다."@ko .
jgk:basemap-B0010000 a skos:Concept ; skos:inScheme jgk:basemap-classes ; skos:broader jgk:basemap-B ;
    skos:notation "B0010000" ; skos:prefLabel "건물"@ko ;
    skos:scopeNote "수치지형도 Ver2.0 레이어 N3A_B0010000. 속성 '종류' 값(아파트, 일반주택, 주택외건물, 무벽건물 등)으로 건물 레이어임을 확인했다."@ko .

jgk:BaseMapFeature a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "국가기본도 지형지물"@ko ;
    rdfs:comment "국토지리정보원 국가기본도(국토정보플랫폼 '국가기본도' 내려받기)의 지형지물 하나. 번호는 국가기본도 객체ID(nf_id)다."@ko .
jgk:DigitalMapFeature a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "수치지형도 지형지물"@ko ;
    rdfs:comment "국토지리정보원 수치지형도 Ver2.0(1:5,000 도엽)의 지형지물 하나. 번호는 유일식별자(UFID, 34자리)다."@ko .
jgk:basemapId a owl:DatatypeProperty ; rdfs:label "국가기본도 객체ID(nf_id)"@ko ; rdfs:range xsd:string .
jgk:molitUfid a owl:DatatypeProperty ; rdfs:label "국토부 UFID(molit_ufid)"@ko ; rdfs:range xsd:string .
jgk:ufid a owl:DatatypeProperty ; rdfs:label "유일식별자(UFID)"@ko ; rdfs:range xsd:string .
jgk:sheetCode a owl:DatatypeProperty ; rdfs:label "도엽코드"@ko ; rdfs:range xsd:string .
jgk:featureCode a owl:ObjectProperty ; rdfs:label "지형지물 분류"@ko ; rdfs:range skos:Concept .
jgk:mapKind a owl:DatatypeProperty ; rdfs:label "지도의 건물 종류"@ko ; rdfs:range xsd:string .
jgk:mapUse a owl:DatatypeProperty ; rdfs:label "지도의 건물 용도"@ko ; rdfs:range xsd:string .
jgk:mapKindCode a owl:DatatypeProperty ; rdfs:label "국가기본도 건물 구분 코드(buld_se)"@ko ;
    rdfs:comment "코드 값의 뜻은 코드 정의서를 확인하지 못해 값 그대로 둔다."@ko ; rdfs:range xsd:string .
jgk:mapUseCode a owl:DatatypeProperty ; rdfs:label "국가기본도 건물 용도 코드(bprp_se)"@ko ;
    rdfs:comment "코드 값의 뜻은 코드 정의서를 확인하지 못해 값 그대로 둔다."@ko ; rdfs:range xsd:string .
jgk:mapFloors a owl:DatatypeProperty ; rdfs:label "지도의 층수"@ko ; rdfs:range xsd:integer .
jgk:basemapFeature a owl:ObjectProperty ; rdfs:label "국가기본도의 같은 건물"@ko ;
    rdfs:comment "모양이 서로 가장 많이 겹치고 IoU가 0.5 이상인 짝. 건물관리번호 여럿이 한 폴리곤을 함께 쓰면 그 건물 모두가 같은 지도 건물을 가리킨다. 겹친 정도는 지도 쪽 jgk:matchIoU에 적는다."@ko ;
    rdfs:domain jgk:Building ; rdfs:range jgk:BaseMapFeature .
jgk:digitalMapFeature a owl:ObjectProperty ; rdfs:label "수치지형도의 같은 건물"@ko ;
    rdfs:comment "jgk:basemapFeature와 같은 규칙으로 수치지형도 건물에 잇는다."@ko ;
    rdfs:domain jgk:Building ; rdfs:range jgk:DigitalMapFeature .
jgk:matchIoU a owl:DatatypeProperty ; rdfs:label "모양 겹침 정도(IoU)"@ko ; rdfs:range xsd:decimal .
jgk:pnuAgrees a owl:DatatypeProperty ; rdfs:label "이은 건물과 PNU가 같다"@ko ; rdfs:range xsd:boolean ;
    rdfs:comment "이은 건물이 여럿이면 하나라도 같을 때 참이다."@ko .
jgk:addressAgrees a owl:DatatypeProperty ; rdfs:label "이은 건물과 도로명주소가 같다"@ko ; rdfs:range xsd:boolean ;
    rdfs:comment "이은 건물이 여럿이면 하나라도 같을 때 참이다. 국가기본도 주소에는 지상, 지하 구분이 없어 지하 주소 건물은 견주지 않는다."@ko .

jgk:Building jgk:basemapClass jgk:basemap-B .
jgk:Road jgk:basemapClass jgk:basemap-A .
jgk:RoadSegment jgk:basemapClass jgk:basemap-A .
jgk:AdminDong jgk:basemapClass jgk:basemap-G .
jgk:LegalDong jgk:basemapClass jgk:basemap-G .

# 객체 사이 관계

jgk:hasEntrance a owl:ObjectProperty ; rdfs:label "출입구를 가진다"@ko ;
    rdfs:domain jgk:Building ; rdfs:range jgk:BuildingEntrance .
jgk:facesRoad a owl:ObjectProperty ; rdfs:label "도로에 면한다"@ko ;
    rdfs:domain jgk:BuildingEntrance ; rdfs:range jgk:RoadSegment .
jgk:locatedOn a owl:ObjectProperty ; rdfs:label "필지 위에 있다"@ko ;
    rdfs:domain jgk:Building ; rdfs:range jgk:Parcel .
jgk:housedIn a owl:ObjectProperty ; rdfs:label "건물 안에 있다"@ko ;
    rdfs:comment "역, 공공시설이 들어 있는 건물을 가리킨다."@ko ;
    rdfs:range jgk:Building .
jgk:adjacentStation a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:label "옆 역"@ko ;
    rdfs:comment "같은 노선에서 바로 옆에 있는 역. 대칭이라 그래프에는 양쪽으로 넣는다."@ko ;
    rdfs:domain jgk:Station ; rdfs:range jgk:Station .
jgk:segmentOf a owl:ObjectProperty ; rdfs:label "도로의 구간이다"@ko ;
    rdfs:domain jgk:RoadSegment ; rdfs:range jgk:Road .
jgk:addressRoad a owl:ObjectProperty ; rdfs:label "도로명주소의 도로"@ko ;
    rdfs:comment "건물 도로명주소에 쓰인 도로명. 실제로 면한 도로 구간은 출입구의 facesRoad로 따로 잇는다."@ko ;
    rdfs:domain jgk:Building ; rdfs:range jgk:Road .
jgk:inLegalDong a owl:ObjectProperty ; rdfs:label "법정동에 속한다"@ko ;
    rdfs:comment "주소의 법정동코드나 PNU 앞 10자리로 정한 소속이다."@ko ;
    rdfs:domain geo:Feature ; rdfs:range jgk:LegalDong .
jgk:inBasicZone a owl:ObjectProperty ; rdfs:label "기초구역에 속한다"@ko ;
    rdfs:comment "건물 주소의 우편번호로 정한 소속이다."@ko ;
    rdfs:domain jgk:Building ; rdfs:range jgk:BasicZone .
jgk:sameBuildingAs a owl:ObjectProperty ; rdfs:label "같은 실물 건물"@ko ;
    rdfs:comment "주소 미연결 건물이 건물관리번호 건물과 같은 실물 건물이라는 연결. 두 객체는 자료가 달라 모양, 용도, 이름, 층수가 서로 다를 수 있다. owl:sameAs로 잇고 추론하면 두 객체의 값과 번호가 한 객체에 섞이므로 쓰지 않는다. 2026-11-02 전에 승인한 제안의 owl:sameAs는 2026-11-03에 이 관계로 옮겼다."@ko ;
    rdfs:domain jgk:Building ; rdfs:range jgk:Building .
jgk:within a owl:ObjectProperty ; rdfs:label "행정동에 속한다"@ko ;
    rdfs:comment "원천 데이터의 행정동코드로 정한 소속이다. 모양끼리의 포함 관계는 geof:sfWithin으로 따로 계산한다."@ko ;
    rdfs:domain geo:Feature ; rdfs:range jgk:AdminDong .

# 상태

jgk:Status a owl:Class ; rdfs:label "객체 상태"@ko .
jgk:status a owl:ObjectProperty ; rdfs:label "상태"@ko ; rdfs:range jgk:Status .
jgk:Active a jgk:Status ; rdfs:label "사용"@ko .
jgk:AddressUnlinked a jgk:Status ; rdfs:label "주소 미연결"@ko .
jgk:AddressLinked a jgk:Status ; rdfs:label "주소 연결됨"@ko .
jgk:Retired a jgk:Status ; rdfs:label "폐지"@ko .
jgk:retiredOn a owl:DatatypeProperty ; rdfs:label "폐지 확인일"@ko ; rdfs:range xsd:date .

# 공식 번호

jgk:buildingMgtNo a owl:DatatypeProperty ; rdfs:label "건물관리번호"@ko ; rdfs:range xsd:string .
jgk:gisBuildingId a owl:DatatypeProperty ; rdfs:label "GIS건물통합식별번호"@ko ; rdfs:range xsd:string .
jgk:pnu a owl:DatatypeProperty ; rdfs:label "PNU"@ko ; rdfs:range xsd:string .
jgk:admDongCode a owl:DatatypeProperty ; rdfs:label "행정동코드"@ko ; rdfs:range xsd:string .
jgk:lineName a owl:DatatypeProperty ; rdfs:label "노선"@ko ; rdfs:domain jgk:Station ; rdfs:range xsd:string .
jgk:agencyCode a owl:DatatypeProperty ; rdfs:label "행정표준코드 기관코드"@ko ; rdfs:range xsd:string .
jgk:agencyName a owl:DatatypeProperty ; rdfs:label "행정표준코드 전체기관명"@ko ; rdfs:range xsd:string .
jgk:facilityType a owl:DatatypeProperty ; rdfs:label "시설 유형"@ko ; rdfs:range xsd:string .
jgk:roadCode a owl:DatatypeProperty ; rdfs:label "도로명코드"@ko ; rdfs:range xsd:string .
jgk:roadSegmentNo a owl:DatatypeProperty ; rdfs:label "도로구간 일련번호"@ko ; rdfs:range xsd:string .
jgk:roadClass a owl:DatatypeProperty ; rdfs:label "도로 위계(고속도로, 대로, 로, 길)"@ko ; rdfs:range xsd:string .
jgk:roadWidth a owl:DatatypeProperty ; rdfs:label "도로 폭(m)"@ko ; rdfs:range xsd:decimal .
jgk:roadLength a owl:DatatypeProperty ; rdfs:label "도로 구간 길이(m)"@ko ; rdfs:range xsd:decimal .
jgk:legalDongCode a owl:DatatypeProperty ; rdfs:label "법정동코드"@ko ; rdfs:range xsd:string .
jgk:basicZoneNo a owl:DatatypeProperty ; rdfs:label "기초구역번호"@ko ; rdfs:range xsd:string .
jgk:subEntranceSeq a owl:DatatypeProperty ; rdfs:label "보조출입구 일련번호"@ko ; rdfs:range xsd:string .

# 건물 속성

jgk:roadAddress a owl:DatatypeProperty ; rdfs:label "도로명주소"@ko ; rdfs:range xsd:string .
jgk:useName a owl:DatatypeProperty ; rdfs:label "용도"@ko ; rdfs:range xsd:string .
jgk:structureName a owl:DatatypeProperty ; rdfs:label "구조"@ko ; rdfs:range xsd:string .
jgk:approvalDate a owl:DatatypeProperty ; rdfs:label "사용승인일"@ko ; rdfs:range xsd:date .
jgk:floorsAbove a owl:DatatypeProperty ; rdfs:label "지상 층수"@ko ; rdfs:range xsd:integer .
jgk:heightM a owl:DatatypeProperty ; rdfs:label "건물 높이(m)"@ko ; rdfs:domain jgk:Building ; rdfs:range xsd:decimal ;
    rdfs:comment "건축물대장의 높이(GIS건물통합정보 A16, 미터). 측량한 높이가 아니라 대장에 적힌 값이다. 입체 지도의 LoD1 높이로 쓴다."@ko .
jgk:floorsBelow a owl:DatatypeProperty ; rdfs:label "지하 층수"@ko ; rdfs:range xsd:integer .
jgk:entranceType a owl:DatatypeProperty ; rdfs:label "출입구 유형"@ko ; rdfs:range xsd:string .

# 상호 (소상공인 상가정보). 이름은 rdfs:label, 주소는 jgk:roadAddress를 함께 쓴다. 값의 가운뎃점은 쉼표로 바꿔 넣었다

jgk:businessNo a owl:DatatypeProperty ; rdfs:label "상가업소번호"@ko ; rdfs:domain jgk:Business ; rdfs:range xsd:string .
jgk:branchName a owl:DatatypeProperty ; rdfs:label "지점명"@ko ; rdfs:domain jgk:Business ; rdfs:range xsd:string .
jgk:categoryLarge a owl:DatatypeProperty ; rdfs:label "상권업종 대분류"@ko ; rdfs:domain jgk:Business ; rdfs:range xsd:string .
jgk:categoryMiddle a owl:DatatypeProperty ; rdfs:label "상권업종 중분류"@ko ; rdfs:domain jgk:Business ; rdfs:range xsd:string .
jgk:categorySmall a owl:DatatypeProperty ; rdfs:label "상권업종 소분류"@ko ; rdfs:domain jgk:Business ; rdfs:range xsd:string .
jgk:floorInfo a owl:DatatypeProperty ; rdfs:label "층 정보"@ko ; rdfs:domain jgk:Business ; rdfs:range xsd:string ;
    rdfs:comment "원천 값 그대로('1', '지', 'B1' 등). 값이 없는 행이 많고, 없으면 넣지 않는다."@ko .
jgk:inBuilding a owl:ObjectProperty ; rdfs:label "들어 있는 건물"@ko ; rdfs:domain jgk:Business ; rdfs:range jgk:Building ;
    rdfs:comment "상가정보의 건물관리번호와 번호가 같은 건물. 그런 건물이 없으면 PNU가 같은 건물이 하나뿐일 때 그 건물이다. 어떻게 이었는지는 jgk:linkedBy에 적는다."@ko .
jgk:onParcel a owl:ObjectProperty ; rdfs:label "있는 필지"@ko ; rdfs:domain jgk:Business ; rdfs:range jgk:Parcel ;
    rdfs:comment "건물을 하나로 정할 수 없을 때(PNU가 같은 건물이 여럿) 상가정보의 PNU로 필지에만 잇는다."@ko .
jgk:linkedBy a owl:DatatypeProperty ; rdfs:label "이은 방법"@ko ; rdfs:domain jgk:Business ; rdfs:range xsd:string ;
    rdfs:comment "'건물관리번호', 'PNU'(필지의 건물이 하나), '필지만' 가운데 하나."@ko .

# 필지에 붙이는 단지 정보 (건축물대장 총괄표제부)

jgk:siteArea a owl:DatatypeProperty ; rdfs:label "대지면적(㎡)"@ko ; rdfs:range xsd:decimal .
jgk:landCategory a owl:DatatypeProperty ; rdfs:label "지목"@ko ; rdfs:domain jgk:Parcel ; rdfs:range rdf:langString ;
    rdfs:comment "지목의 정식 이름(대, 도로, 공장용지 등 28가지). 연속지적도 지번 표기 끝의 부호를 바꾼 값이다. 측량에 쓰지 못하는 참조용 도면의 값이다."@ko .
jgk:cadastralDate a owl:DatatypeProperty ; rdfs:label "필지 경계 자료 기준일"@ko ; rdfs:domain jgk:Parcel ; rdfs:range xsd:date ;
    rdfs:comment "연속지적도 파일 전체의 데이터 기준일(A6)이다. 필지마다 따로 정한 날짜가 아니다."@ko .
jgk:totalFloorArea a owl:DatatypeProperty ; rdfs:label "연면적(㎡)"@ko ; rdfs:range xsd:decimal .
jgk:households a owl:DatatypeProperty ; rdfs:label "세대수"@ko ; rdfs:range xsd:integer .
jgk:mainBuildingCount a owl:DatatypeProperty ; rdfs:label "주건축물 수"@ko ; rdfs:range xsd:integer .
jgk:complexMainUse a owl:DatatypeProperty ; rdfs:label "단지 주용도"@ko ; rdfs:range xsd:string .

# 변경 제안 (승인된 것만 그래프에 들어온다)

jgk:Notice a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "고시공고"@ko ;
    rdfs:comment "구청 고시 한 건. URI는 고시 번호(시군구코드-연도-번호)를 그대로 쓴다. 구역, 사업에는 전국 공통 번호가 없어 고시를 객체로 두고 대상을 잇는다."@ko .
jgk:noticeNumber a owl:DatatypeProperty ; rdfs:label "고시 번호"@ko ; rdfs:domain jgk:Notice ; rdfs:range xsd:string .
jgk:zoneKind a owl:DatatypeProperty ; rdfs:label "구역, 사업 종류"@ko ; rdfs:domain jgk:Notice ; rdfs:range xsd:string .
jgk:zoneDesignatedBy a owl:ObjectProperty ; rdfs:label "구역 지정, 결정 고시"@ko ; rdfs:domain geo:Feature ; rdfs:range jgk:Notice .
jgk:zoneReleasedBy a owl:ObjectProperty ; rdfs:label "지정 해제, 실효 고시"@ko ; rdfs:domain geo:Feature ; rdfs:range jgk:Notice .
jgk:planApprovedBy a owl:ObjectProperty ; rdfs:label "사업, 계획 인가 고시"@ko ; rdfs:domain geo:Feature ; rdfs:range jgk:Notice .
jgk:completedBy a owl:ObjectProperty ; rdfs:label "준공, 공사완료 고시"@ko ; rdfs:domain geo:Feature ; rdfs:range jgk:Notice .

jgk:ChangeProposal a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "변경 제안"@ko .
jgk:affects a owl:ObjectProperty ; rdfs:label "바꾸는 대상"@ko ; rdfs:domain jgk:ChangeProposal .
jgk:proposalAction a owl:DatatypeProperty ; rdfs:label "제안 종류(create, update, retire, link)"@ko ;
    rdfs:comment "변경 기록(rdf:Statement)에는 승인 철회 사건을 뜻하는 withdraw도 쓴다."@ko .
jgk:sourceKind a owl:DatatypeProperty ; rdfs:label "제안 출처(rule-candidate, data-diff, llm-notice, notice-table)"@ko .
jgk:decidedBy a owl:DatatypeProperty ; rdfs:label "결정한 검토자"@ko ;
    rdfs:comment "승인이나 정정을 한 검토자 이름. 사람이거나, 사람이 맡긴 자동 검토자다(기록에 'Claude (사용자 위임)'처럼 그대로 남는다). 변경 기록에는 정정 사건의 검토자도 적는다."@ko .
jgk:decidedAt a owl:DatatypeProperty ; rdfs:label "결정 시각"@ko ; rdfs:range xsd:dateTime ;
    rdfs:comment "승인 시각. 변경 기록에는 정정 사건의 시각도 적는다."@ko .
jgk:hasChange a owl:ObjectProperty ; rdfs:label "바꾼 트리플"@ko ; rdfs:domain jgk:ChangeProposal ; rdfs:range rdf:Statement ;
    rdfs:comment "승인된 제안이 넣거나 뺀 트리플 하나. rdf:subject, rdf:predicate, rdf:object와 jgk:changeOp로 적는다. 이 기록으로 승인 전 시점의 그래프를 되살린다."@ko .
jgk:changeOp a owl:DatatypeProperty ; rdfs:label "넣기(add) 또는 빼기(remove)"@ko ; rdfs:range xsd:string .
jgk:changeOf a owl:ObjectProperty ; rdfs:label "이 변경을 낸 제안"@ko ; rdfs:domain rdf:Statement ; rdfs:range jgk:ChangeProposal ;
    rdfs:comment "승인을 철회해 제안 노드가 빠져도 변경 기록은 이 관계로 제안을 가리킨다."@ko .
jgk:changeOrder a owl:DatatypeProperty ; rdfs:label "변경 재생 순서"@ko ; rdfs:domain rdf:Statement ; rdfs:range xsd:integer ;
    rdfs:comment "결정의 일련번호 * 1,000,000 + 제안 안의 차례. 시각 T의 값은 트리플마다 이 번호가 가장 큰 사건으로 정한다."@ko .

# BIM 모델과 잇기 (docs/bim.md)

jgk:bimBuilding a owl:ObjectProperty ; rdfs:label "BIM 모델 건물"@ko ; rdfs:domain jgk:Building ;
    rdfs:comment "같은 실물 건물의 BIM 모델 건물(IFC를 W3C BOT로 바꾼 bot:Building). BIM의 층, 공간, 부재는 BIM 그래프에 두고 여기에는 이 연결만 둔다. 제안을 거쳐 승인한 연결만 넣는다(src/review/bim_proposals.py)."@ko .

# 센서와 관측 (W3C, OGC 공동 표준 SOSA/SSN)

jgk:Sensor a owl:Class ; rdfs:subClassOf sosa:Sensor, geo:Feature ; rdfs:label "센서"@ko ;
    rdfs:comment "서울시 도시데이터 센서(S-DoT). URI는 모델 시리얼을 그대로 쓴다. 센서도 위치가 있는 공간 객체라 geo:Feature다."@ko .
jgk:sensorSerial a owl:DatatypeProperty ; rdfs:label "센서 시리얼"@ko ; rdfs:domain jgk:Sensor ; rdfs:range xsd:string .
jgk:sensorModel a owl:DatatypeProperty ; rdfs:label "센서 모델 번호"@ko ; rdfs:domain jgk:Sensor ; rdfs:range xsd:string .
jgk:installArea a owl:DatatypeProperty ; rdfs:label "설치 지역 종류"@ko ; rdfs:domain jgk:Sensor ; rdfs:range xsd:string ;
    rdfs:comment "원본 값 그대로(residential_area, main_street, roads_and_parks 등)."@ko .
jgk:installAddress a owl:DatatypeProperty ; rdfs:label "설치 주소"@ko ; rdfs:domain jgk:Sensor ; rdfs:range xsd:string .
jgk:addressBuilding a owl:ObjectProperty ; rdfs:label "설치 주소의 건물"@ko ; rdfs:domain jgk:Sensor ; rdfs:range jgk:Building ;
    rdfs:comment "설치 주소와 도로명주소가 같은 건물. 센서는 가로등이나 전봇대에 달린 것으로 보여 건물에서 8.8~24.1m 떨어져 있어, 건물에 달렸다(sosa:isHostedBy)고 쓰지 않는다. 한 주소에 건물이 여러 동이면 센서에서 가장 가까운 동이다."@ko .
jgk:addressBuildingDistance a owl:DatatypeProperty ; rdfs:label "설치 주소 건물까지 거리(m)"@ko ; rdfs:domain jgk:Sensor ; rdfs:range xsd:decimal .
jgk:unit a owl:ObjectProperty ; rdfs:label "단위"@ko ; rdfs:domain sosa:ObservableProperty ;
    rdfs:comment "QUDT 단위 어휘의 단위."@ko .
jgk:sourceColumn a owl:DatatypeProperty ; rdfs:label "원본 열 이름"@ko ; rdfs:range xsd:string .

jgk:temperature a sosa:ObservableProperty ; rdfs:label "기온"@ko ; jgk:unit unit:DEG_C ; jgk:sourceColumn "온도 평균(℃)" .
jgk:humidity a sosa:ObservableProperty ; rdfs:label "상대 습도"@ko ; jgk:unit unit:PERCENT ; jgk:sourceColumn "습도 평균(%)" .
jgk:noise a sosa:ObservableProperty ; rdfs:label "소음"@ko ; jgk:unit unit:DeciB ; jgk:sourceColumn "소음 평균(dB)" .
jgk:illuminance a sosa:ObservableProperty ; rdfs:label "조도"@ko ; jgk:unit unit:LUX ; jgk:sourceColumn "조도 평균(lux)" .
jgk:uv a sosa:ObservableProperty ; rdfs:label "자외선"@ko ; jgk:unit unit:UNITLESS ; jgk:sourceColumn "자외선 평균(UV)" ;
    rdfs:comment "원본 단위 표기가 'UV'뿐이고 QUDT에 맞는 단위가 없어 단위 없음으로 둔다."@ko .

# 다른 표준 어휘의 이름을 화면에 한국어로 보이려고 붙인 이름
sosa:Sensor rdfs:label "센서(SOSA)"@ko .
sosa:Observation rdfs:label "관측(SOSA)"@ko .
sosa:ObservableProperty rdfs:label "관측 항목(SOSA)"@ko .
sosa:madeBySensor rdfs:label "관측한 센서"@ko .
sosa:observes rdfs:label "관측 항목"@ko .
sosa:observedProperty rdfs:label "관측 항목"@ko .
sosa:hasSimpleResult rdfs:label "관측값"@ko .
sosa:resultTime rdfs:label "관측 시각"@ko .
sosa:hasFeatureOfInterest rdfs:label "관측 대상"@ko .

# 출처

jgk:Dataset a owl:Class ; rdfs:label "원천 데이터"@ko ; rdfs:subClassOf dcat:Dataset ;
    rdfs:comment "그래프에 들어온 원천 자료. 자료마다 이용 조건(dcterms:license)과 공개 등급(dcterms:accessRights)을 꼭 적는다(SHACL). 공개 등급은 config/area.yaml의 공개 보류 목록에서 만든다."@ko .
