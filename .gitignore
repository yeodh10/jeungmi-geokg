# 원본 데이터는 커밋하지 않는다. 받는 방법은 docs/data-sources.md에 있다.
data/raw/*
!data/raw/.gitkeep

# 가공 데이터도 올리지 않는다. 수치지형도와 국가기본도는 공간정보관리법의 국외 반출 제한 때문에 공개 저장소에 올리지 않고,
# 전자지도 2종은 공개 보류를 유지한다 (docs/decisions.md 참고)
data/processed/*
!data/processed/.gitkeep

# 비밀 값
.env

# 파이썬
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 편집기, 운영체제
.vscode/
.idea/
Thumbs.db
.DS_Store

# 개발 도구 설정
.claude/
