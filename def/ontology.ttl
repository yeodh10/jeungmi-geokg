@prefix jgk: <https://yeodh10.github.io/jeungmi-geokg/def#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# 증미역 공간 지식 그래프 어휘
# 모든 객체는 geo:Feature, 모양은 geo:Geometry로 따로 둔다.

<https://yeodh10.github.io/jeungmi-geokg/def> a owl:Ontology ;
    rdfs:label "증미역 공간 지식 그래프 어휘"@ko ;
    owl:imports <http://www.opengis.net/ont/geosparql> .

# 객체 종류

jgk:Building a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "건물"@ko .
jgk:BuildingEntrance a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "건물 출입구"@ko .
jgk:RoadSegment a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "도로 구간"@ko .
jgk:Parcel a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "필지"@ko ;
    rdfs:comment "지금은 모양 없이 PNU만 가진다. 연속지적도를 붙이면 모양을 더한다."@ko .
jgk:PublicFacility a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "공공시설"@ko .
jgk:Station a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "역"@ko .
jgk:AdminDong a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "행정동"@ko .
jgk:Road a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "도로"@ko ;
    rdfs:comment "도로명 하나. 번호는 도로명코드(시군구코드 5자리 + 도로명번호 7자리)다. 모양은 도로 구간이 가진다."@ko .
jgk:LegalDong a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "법정동"@ko .
jgk:BasicZone a owl:Class ; rdfs:subClassOf geo:Feature ; rdfs:label "기초구역"@ko ;
    rdfs:comment "국가기초구역. 번호 5자리는 우편번호와 같다."@ko .

# 객체 사이 관계

jgk:hasEntrance a owl:ObjectProperty ; rdfs:label "출입구를 가진다"@ko ;
    rdfs:domain jgk:Building ; rdfs:range jgk:BuildingEntrance .
jgk:facesRoad a owl:ObjectProperty ; rdfs:label "도로에 면한다"@ko ;
    rdfs:domain jgk:BuildingEntrance ; rdfs:range jgk:RoadSegment .
jgk:locatedOn a owl:ObjectProperty ; rdfs:label "필지 위에 있다"@ko ;
    rdfs:domain jgk:Building ; rdfs:range jgk:Parcel .
jgk:housedIn a owl:ObjectProperty ; rdfs:label "건물 안에 있다"@ko ;
    rdfs:comment "역, 공공시설이 들어 있는 건물을 가리킨다."@ko ;
    rdfs:range jgk:Building .
jgk:segmentOf a owl:ObjectProperty ; rdfs:label "도로의 구간이다"@ko ;
    rdfs:domain jgk:RoadSegment ; rdfs:range jgk:Road .
jgk:addressRoad a owl:ObjectProperty ; rdfs:label "도로명주소의 도로"@ko ;
    rdfs:comment "건물 도로명주소에 쓰인 도로명. 실제로 면한 도로 구간은 출입구의 facesRoad로 따로 잇는다."@ko ;
    rdfs:domain jgk:Building ; rdfs:range jgk:Road .
jgk:inLegalDong a owl:ObjectProperty ; rdfs:label "법정동에 속한다"@ko ;
    rdfs:comment "주소의 법정동코드나 PNU 앞 10자리로 정한 소속이다."@ko ;
    rdfs:domain geo:Feature ; rdfs:range jgk:LegalDong .
jgk:inBasicZone a owl:ObjectProperty ; rdfs:label "기초구역에 속한다"@ko ;
    rdfs:comment "건물 주소의 우편번호로 정한 소속이다."@ko ;
    rdfs:domain jgk:Building ; rdfs:range jgk:BasicZone .
jgk:within a owl:ObjectProperty ; rdfs:label "행정동에 속한다"@ko ;
    rdfs:comment "원천 데이터의 행정동코드로 정한 소속이다. 모양끼리의 포함 관계는 geof:sfWithin으로 따로 계산한다."@ko ;
    rdfs:domain geo:Feature ; rdfs:range jgk:AdminDong .

# 상태

jgk:Status a owl:Class ; rdfs:label "객체 상태"@ko .
jgk:status a owl:ObjectProperty ; rdfs:label "상태"@ko ; rdfs:range jgk:Status .
jgk:Active a jgk:Status ; rdfs:label "사용"@ko .
jgk:AddressUnlinked a jgk:Status ; rdfs:label "주소 미연결"@ko .
jgk:AddressLinked a jgk:Status ; rdfs:label "주소 연결됨"@ko .
jgk:Retired a jgk:Status ; rdfs:label "폐지"@ko .
jgk:retiredOn a owl:DatatypeProperty ; rdfs:label "폐지 확인일"@ko ; rdfs:range xsd:date .

# 공식 번호

jgk:buildingMgtNo a owl:DatatypeProperty ; rdfs:label "건물관리번호"@ko ; rdfs:range xsd:string .
jgk:gisBuildingId a owl:DatatypeProperty ; rdfs:label "GIS건물통합식별번호"@ko ; rdfs:range xsd:string .
jgk:pnu a owl:DatatypeProperty ; rdfs:label "PNU"@ko ; rdfs:range xsd:string .
jgk:admDongCode a owl:DatatypeProperty ; rdfs:label "행정동코드"@ko ; rdfs:range xsd:string .
jgk:lineName a owl:DatatypeProperty ; rdfs:label "노선"@ko ; rdfs:domain jgk:Station ; rdfs:range xsd:string .
jgk:agencyCode a owl:DatatypeProperty ; rdfs:label "행정표준코드 기관코드"@ko ; rdfs:range xsd:string .
jgk:agencyName a owl:DatatypeProperty ; rdfs:label "행정표준코드 전체기관명"@ko ; rdfs:range xsd:string .
jgk:facilityType a owl:DatatypeProperty ; rdfs:label "시설 유형"@ko ; rdfs:range xsd:string .
jgk:roadCode a owl:DatatypeProperty ; rdfs:label "도로명코드"@ko ; rdfs:range xsd:string .
jgk:roadSegmentNo a owl:DatatypeProperty ; rdfs:label "도로구간 일련번호"@ko ; rdfs:range xsd:string .
jgk:roadClass a owl:DatatypeProperty ; rdfs:label "도로 위계(고속도로, 대로, 로, 길)"@ko ; rdfs:range xsd:string .
jgk:roadWidth a owl:DatatypeProperty ; rdfs:label "도로 폭(m)"@ko ; rdfs:range xsd:decimal .
jgk:roadLength a owl:DatatypeProperty ; rdfs:label "도로 구간 길이(m)"@ko ; rdfs:range xsd:decimal .
jgk:legalDongCode a owl:DatatypeProperty ; rdfs:label "법정동코드"@ko ; rdfs:range xsd:string .
jgk:basicZoneNo a owl:DatatypeProperty ; rdfs:label "기초구역번호"@ko ; rdfs:range xsd:string .
jgk:subEntranceSeq a owl:DatatypeProperty ; rdfs:label "보조출입구 일련번호"@ko ; rdfs:range xsd:string .

# 건물 속성

jgk:roadAddress a owl:DatatypeProperty ; rdfs:label "도로명주소"@ko ; rdfs:range xsd:string .
jgk:useName a owl:DatatypeProperty ; rdfs:label "용도"@ko ; rdfs:range xsd:string .
jgk:structureName a owl:DatatypeProperty ; rdfs:label "구조"@ko ; rdfs:range xsd:string .
jgk:approvalDate a owl:DatatypeProperty ; rdfs:label "사용승인일"@ko ; rdfs:range xsd:date .
jgk:floorsAbove a owl:DatatypeProperty ; rdfs:label "지상층수"@ko ; rdfs:range xsd:integer .
jgk:floorsBelow a owl:DatatypeProperty ; rdfs:label "지하층수"@ko ; rdfs:range xsd:integer .
jgk:entranceType a owl:DatatypeProperty ; rdfs:label "출입구 유형"@ko ; rdfs:range xsd:string .

# 필지에 붙이는 단지 정보 (건축물대장 총괄표제부)

jgk:siteArea a owl:DatatypeProperty ; rdfs:label "대지면적(㎡)"@ko ; rdfs:range xsd:decimal .
jgk:totalFloorArea a owl:DatatypeProperty ; rdfs:label "연면적(㎡)"@ko ; rdfs:range xsd:decimal .
jgk:households a owl:DatatypeProperty ; rdfs:label "세대수"@ko ; rdfs:range xsd:integer .
jgk:mainBuildingCount a owl:DatatypeProperty ; rdfs:label "주건축물수"@ko ; rdfs:range xsd:integer .
jgk:complexMainUse a owl:DatatypeProperty ; rdfs:label "단지 주용도"@ko ; rdfs:range xsd:string .

# 변경 제안 (사람이 승인한 것만 그래프에 들어온다)

jgk:ChangeProposal a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "변경 제안"@ko .
jgk:affects a owl:ObjectProperty ; rdfs:label "바꾸는 대상"@ko ; rdfs:domain jgk:ChangeProposal .
jgk:proposalAction a owl:DatatypeProperty ; rdfs:label "제안 종류(create, update, retire, link)"@ko .
jgk:sourceKind a owl:DatatypeProperty ; rdfs:label "제안 출처(rule-candidate, data-diff, llm-notice, notice-table)"@ko .
jgk:decidedBy a owl:DatatypeProperty ; rdfs:label "승인한 사람"@ko .
jgk:decidedAt a owl:DatatypeProperty ; rdfs:label "승인 시각"@ko ; rdfs:range xsd:dateTime .

# 출처

jgk:Dataset a owl:Class ; rdfs:label "원천 데이터"@ko .
jgk:sourceGisBuildingId a owl:DatatypeProperty ; rdfs:label "모양을 가져온 GIS 건물 번호"@ko ;
    rdfs:domain geo:Geometry ; rdfs:range xsd:string .

jgk:dataset-gis-building a jgk:Dataset ;
    dcterms:title "국토교통부 GIS건물통합정보 (AL_D010, 서울)"@ko ;
    rdfs:label "국토교통부 GIS건물통합정보 (AL_D010, 서울)"@ko ;
    dcterms:source <https://www.data.go.kr/data/15052097/fileData.do> .
jgk:dataset-navi-db a jgk:Dataset ;
    dcterms:title "행정안전부 도로명주소 내비게이션용DB (2026년 9월분)"@ko ;
    rdfs:label "행정안전부 도로명주소 내비게이션용DB (2026년 9월분)"@ko ;
    dcterms:source <https://www.data.go.kr/data/15050419/fileData.do> .
jgk:dataset-public-office a jgk:Dataset ;
    dcterms:title "행정안전부 민원행정기관 전자지도 (2024년 1월분)"@ko ;
    rdfs:label "행정안전부 민원행정기관 전자지도 (2024년 1월분)"@ko ;
    dcterms:source <https://business.juso.go.kr> .
jgk:dataset-juso-emap a jgk:Dataset ;
    dcterms:title "행정안전부 도로명주소 전자지도 (서울, 2026년 9월분)"@ko ;
    rdfs:label "행정안전부 도로명주소 전자지도 (서울, 2026년 9월분)"@ko ;
    dcterms:source <https://business.juso.go.kr> .
jgk:dataset-agency-code a jgk:Dataset ;
    dcterms:title "행정안전부 행정표준코드 기관코드"@ko ;
    rdfs:label "행정안전부 행정표준코드 기관코드"@ko ;
    dcterms:source <https://www.data.go.kr/data/15077870/openapi.do> .
jgk:dataset-building-register a jgk:Dataset ;
    dcterms:title "서울시 건축물대장 총괄표제부"@ko ;
    rdfs:label "서울시 건축물대장 총괄표제부"@ko ;
    dcterms:source <https://data.seoul.go.kr/dataList/OA-23051/S/1/datasetView.do> .
